{
  "expo": {
    "name": "POCKT",
    "slug": "POCKT",
    "version": "13.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/pockt-2-app-icon-approved.png",
    "scheme": "pockt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/branding/pockt-2-app-icon-approved.png",
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.moneytest.pockt",
      "buildNumber": "165",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "POCKT uses your photo library so you can set a photograph as the Custom metronome background.",
        "NSCameraUsageDescription": "POCKT uses the camera only to pulse the rear flashlight with the metronome. No photos or video are taken.",
        "NSMicrophoneUsageDescription": "POCKT uses the microphone to tune your instrument and to record a take against the metronome. Audio stays on this device."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0908",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/launch-field.png",
          "imageWidth": 8,
          "resizeMode": "contain",
          "backgroundColor": "#141311",
          "dark": {
            "image": "./assets/branding/launch-field.png",
            "backgroundColor": "#141311"
          },
          "ios": {
            "image": "./assets/branding/launch-field.png",
            "imageWidth": 8,
            "resizeMode": "contain",
            "backgroundColor": "#141311"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "POCKT uses the microphone to tune your instrument and to record a take against the metronome. Audio stays on this device.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "POCKT uses the camera only to pulse the rear flashlight with the metronome. No photos or video are taken.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "POCKT uses your photo library so you can set a photograph as the Custom metronome background.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./modules/pockt-timing/ios/Clicks"
          ]
        }
      ],
      "expo-video",
      "./modules/pockt-timing/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c96ab221-1c37-49b7-85ad-9c02d3412efe"
      }
    },
    "owner": "money-test"
  }
}
